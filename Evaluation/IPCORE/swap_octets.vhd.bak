LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
USE ieee.numeric_std.ALL;

ENTITY swap_octets IS
    PORT (
        clk        : IN  STD_LOGIC;
        resetn     : IN  STD_LOGIC;
        address    : IN  STD_LOGIC_VECTOR(1 DOWNTO 0); -- 4 registres max
        chipselect : IN  STD_LOGIC;
        read       : IN  STD_LOGIC;
        write      : IN  STD_LOGIC;
        writedata  : IN  STD_LOGIC_VECTOR(31 DOWNTO 0);
        readdata   : OUT STD_LOGIC_VECTOR(31 DOWNTO 0);
        waitrequest: OUT STD_LOGIC
    );
END swap_octets;

ARCHITECTURE rtl OF swap_octets IS
    SIGNAL reg_data : STD_LOGIC_VECTOR(31 DOWNTO 0);
BEGIN

    -- Gestion du waitrequest (pas de délai, transaction immédiate)
    waitrequest <= '0';

    -- Processus principal de lecture/écriture
    PROCESS(clk, resetn)
    BEGIN
        IF resetn = '0' THEN
            reg_data <= (OTHERS => '0');
            readdata <= (OTHERS => '0');
        ELSIF rising_edge(clk) THEN
            -- Écriture
            IF chipselect = '1' AND write = '1' THEN
                -- Stocke la donnée et fait le swap immédiatement
                reg_data <= writedata(7 DOWNTO 0)   & 
                            writedata(15 DOWNTO 8)  & 
                            writedata(23 DOWNTO 16) & 
                            writedata(31 DOWNTO 24);
            END IF;

            -- Lecture
            IF chipselect = '1' AND read = '1' THEN
                readdata <= reg_data;
            END IF;
        END IF;
    END PROCESS;

END rtl;